# Copiá este archivo como .env.local y completalo. .env.local no se sube a git.

# Cuentas de MT5 y el puerto de su puente (python bridge/ric_bridge.py --puerto ...)
RIC_CUENTAS=exness:8701,blackbull:8702

# Clave compartida entre la terminal y los puentes (32 caracteres al azar).
# Generala con: python -c "import secrets; print(secrets.token_hex(16))"
RIC_BRIDGE_TOKEN=
